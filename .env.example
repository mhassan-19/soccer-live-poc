# Copy this file to .env and fill in your key. Never commit .env.
SPORTRADAR_API_KEY=

# Leave empty to auto-pick: sample data when there is no key, live data when there is one.
# Set true to force sample data, false to force live data.
USE_MOCK=

# Soccer API settings (change only if your package differs)
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_VERSION=v4
SPORTRADAR_LANG=en

# Minimum gap between calls to Sportradar (trial keys allow about 1 request per second)
MIN_REQUEST_INTERVAL_MS=1100

# How often the browser refreshes, in seconds. Trial keys have a small monthly quota,
# so keep this at 30 or higher while testing.
POLL_SECONDS=30

PORT=3000

# Max matches the server can measure at once (each uses API quota)
MAX_WATCHERS=3
